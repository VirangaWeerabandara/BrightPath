# Copy this file to .env.prod on the cloud host and fill in real values.
# Used by: ./deploy-cloud.sh

# --- Backend ---
PORT=4000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/brightpath?retryWrites=true&w=majority
SECRET=your_jwt_secret_key_here
CORS_ORIGIN=http://your-domain-or-server-ip
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Frontend (baked into the build) ---
# Must be the publicly reachable URL of the backend, e.g. https://api.yourdomain.com/api
REACT_APP_API_URL=http://your-domain-or-server-ip:4000/api
